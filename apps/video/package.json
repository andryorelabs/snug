  },
  "type": "module",
  "dependencies": {
    "@remotion/bundler": "4.0.541",
    "@remotion/cli": "4.0.541",
    "@remotion/fonts": "4.0.541",
    "@remotion/google-fonts": "4.0.541",
    "@remotion/layout-utils": "4.0.541",
    "@remotion/media": "4.0.541",
    "@remotion/renderer": "4.0.541",
    "@remotion/transitions": "4.0.541",
    "react": "catalog:",
    "react-dom": "catalog:",
    "remotion": "4.0.541",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@snug/extension": "workspace:*",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/web": "0.0.359",
    "typescript": "catalog:",
    "@vitest/coverage-v8": "^5.0.4",
    "vitest": "catalog:"
  },
  "scripts": {
    "studio": "if command -v remotion-studio >/dev/null 2>&1; then remotion-studio src/index.ts --port 3123; else remotion studio src/index.ts --port 3123; fi",
    "still": "remotion still src/index.ts",
    "render": "bun scripts/render-all.ts",
    "thumbnails": "bun scripts/render-thumbnails.ts",
    "check": "node ../../node_modules/typescript7/bin/tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  }
