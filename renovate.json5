{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:best-practices",
    ":dependencyDashboard",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)",
    "helpers:pinGitHubActionDigests",
    "group:monorepos",
    "group:recommended",
    ":preserveSemverRanges",
  ],

  baseBranchPatterns: ["develop"],

  timezone: "UTC",
  schedule: ["before 12pm on monday"],

  // Rate limits — low noise for solo dev
  prConcurrentLimit: 3,
  prHourlyLimit: 2,
  branchConcurrentLimit: 5,

  rangeStrategy: "bump",
  // Develop requires the PR branch to be up to date before merging
  // (strict_required_status_checks_policy in the develop branch ruleset),
  // so automerge branches must be kept current, not just conflict-free
  rebaseWhen: "behind-base-branch",

  // Wait 3 days before opening a PR — guards against supply-chain attacks on freshly published versions
  minimumReleaseAge: "3 days",

  labels: ["dependencies"],

  // Vulnerability sources: OSV and Dependabot alerts. Renovate stays the only
  // version updater (docs/adr/0001-public-repo-security-posture.md)
  osvVulnerabilityAlerts: true,
  vulnerabilityAlerts: {
    enabled: true,
    labels: ["Priority: Critical", "Type: Security"],
    assignees: ["AndryOre"],
  },

  // Lockfile refresh — covers the bun workspaces and the root catalog
  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 12pm on monday"],
    automerge: true,
    automergeType: "pr",
  },

  customManagers: [
    // Bumping ACTIONLINT_VERSION leaves ACTIONLINT_SHA256 stale: the Renovate PR
    // fails lint-workflows until the checksum is updated by hand
    {
      customType: "regex",
      managerFilePatterns: ["/^\\.github/workflows/lint-workflows\\.yml$/"],
      matchStrings: ["ACTIONLINT_VERSION: (?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      datasourceTemplate: "github-releases",
      depNameTemplate: "rhysd/actionlint",
      extractVersionTemplate: "^v(?<version>.+)$",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^\\.github/workflows/lint-workflows\\.yml$/"],
      matchStrings: [
        "zizmorcore/zizmor-action@[^\\n]+\\n\\s+with:\\n\\s+version: (?<currentValue>v\\d+\\.\\d+\\.\\d+)",
      ],
      datasourceTemplate: "github-releases",
      depNameTemplate: "zizmorcore/zizmor",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^apps/site/scripts/.+\\.sh$/"],
      matchStrings: ["lighthouse@(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      datasourceTemplate: "npm",
      depNameTemplate: "lighthouse",
    },
  ],

  // apps/site (Astro, @astrojs/*) needs no dedicated rule: its dependencies fall
  // under the dependencies/devDependencies and all non-major rules below, and
  // react/tailwind come from the root catalog groups
  packageRules: [
    {
      matchDepTypes: ["devDependencies"],
      semanticCommitScope: "deps-dev",
    },
    {
      matchDepTypes: ["dependencies"],
      semanticCommitScope: "deps",
    },

    {
      matchUpdateTypes: ["minor", "patch"],
      groupName: "all non-major",
      groupSlug: "all-minor-patch",
    },

    // WXT framework bundle — keep these in sync
    {
      groupName: "wxt",
      matchPackageNames: ["wxt", "@wxt-dev/**"],
    },
    {
      groupName: "react",
      matchPackageNames: ["react", "react-dom", "@types/react*"],
    },
    {
      groupName: "base ui + lucide",
      matchPackageNames: ["@base-ui/react", "lucide-react"],
    },
    // Catalog entries without a group of their own below move together: Renovate
    // bumps the root catalog once for every workspace that references them
    {
      groupName: "workspace catalog",
      matchFileNames: ["package.json"],
      matchDepNames: ["cn"],
    },
    {
      groupName: "tailwindcss",
      matchPackageNames: ["tailwindcss", "@tailwindcss/**"],
    },
    {
      groupName: "vitest",
      matchPackageNames: ["vitest", "@vitest/**"],
    },
    {
      groupName: "type definitions",
      matchPackageNames: ["@types/**"],
    },

    {
      groupName: "github-actions",
      matchManagers: ["github-actions"],
    },

    // OPT-IN AUTOMERGE — active: branch protection + required "CI passed" status check
    // are now enforced on develop (AO-827, docs/adr/0001-public-repo-security-posture.md)
    // Uses 7-day release age (stricter than global 3-day) as extra supply-chain buffer
    {
      matchDepTypes: ["devDependencies"],
      matchUpdateTypes: ["patch", "minor"],
      automerge: true,
      automergeType: "pr",
      minimumReleaseAge: "7 days",
    },
    {
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["patch", "minor", "digest", "pinDigest"],
      automerge: true,
      automergeType: "pr",
      minimumReleaseAge: "7 days",
    },
    // Toolchain pin groups (standard rule F5, table in scripts/toolchain-table.md):
    // each moves in its own reviewed PR and never automerges, because lint,
    // format, typecheck or runtime results change between releases. Declared
    // after every automerge rule so they win
    {
      groupName: "oxc",
      matchDepNames: ["oxlint", "oxlint-tsgolint", "oxfmt"],
      rangeStrategy: "pin",
      automerge: false,
    },
    {
      groupName: "typescript7",
      matchDepNames: ["typescript7"],
      rangeStrategy: "pin",
      automerge: false,
    },
    // packageManager, engines.bun and @types/bun share one version
    {
      groupName: "bun",
      matchDepNames: ["bun", "@types/bun"],
      rangeStrategy: "pin",
      automerge: false,
    },
  ],
}
