{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "agentGuidance": false,
  "globalDependencies": ["bun.lock", "bunfig.toml", "tsconfig.base.json"],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "check": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/typecheck-site.ts",
        "!.output/**",
        "!.wxt/**",
        "!dist/**",
        "!.astro/**",
        "!coverage/**"
      ],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["check"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!.output/**",
        "!.wxt/**",
        "!dist/**",
        "!.astro/**",
        "!coverage/**"
      ],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!.output/**",
        "!.wxt/**",
        "!dist/**",
        "!.astro/**",
        "!coverage/**"
      ],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "cache": false,
      "passThroughEnv": ["PWDEBUG", "AXE_MATRIX"]
    },
    "test:e2e:prebuilt": {
      "cache": false,
      "passThroughEnv": ["PWDEBUG", "AXE_MATRIX"]
    },
    "build": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!.output/**",
        "!dist/**",
        "!.astro/**",
        "!coverage/**",
        "!e2e/**"
      ],
      "outputs": [".output/**", ".wxt/**", "dist/**", ".astro/**"]
    },
    "zip": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!.output/**",
        "!dist/**",
        "!.astro/**",
        "!coverage/**",
        "!e2e/**"
      ],
      "outputs": [".output/**", ".wxt/**", "dist/**", ".astro/**"]
    },
    "@snug/site#sync": {
      "inputs": ["$TURBO_DEFAULT$", "!.astro/**"],
      "outputs": [".astro/**"]
    },
    "//#check:root": {
      "dependsOn": ["@snug/site#sync"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!apps/*/.output/**",
        "!apps/*/.wxt/**",
        "!apps/*/dist/**",
        "!apps/*/.astro/**",
        "!**/coverage/**"
      ],
      "outputs": []
    },
    "//#test:root": {
      "inputs": [
        "scripts/**",
        "eslint-rules/**",
        "docs/**",
        ".github/**",
        ".claude/hooks/**",
        ".claude/skills/**",
        ".claude/settings.json",
        ".husky/**",
        "apps/**",
        "packages/**",
        "*.md",
        "llms.txt",
        "skills-lock.json",
        "emet.config.json",
        ".gitattributes",
        ".gitignore",
        ".env.example",
        "oxlint-plugins/**",
        "oxlint.config.ts",
        "lint-policy.mjs",
        "lint-policy.d.mts",
        "eslint.config.mjs",
        "vitest.config.ts",
        "renovate.json5",
        "lint-staged.config.mjs",
        "package.json"
      ],
      "outputs": []
    },
    "//#test:coverage:root": {
      "inputs": [
        "scripts/**",
        "eslint-rules/**",
        "docs/**",
        ".github/**",
        ".claude/hooks/**",
        ".claude/skills/**",
        ".claude/settings.json",
        ".husky/**",
        "apps/**",
        "packages/**",
        "*.md",
        "llms.txt",
        "skills-lock.json",
        "emet.config.json",
        ".gitattributes",
        ".gitignore",
        ".env.example",
        "oxlint-plugins/**",
        "oxlint.config.ts",
        "lint-policy.mjs",
        "lint-policy.d.mts",
        "eslint.config.mjs",
        "vitest.config.ts",
        "renovate.json5",
        "lint-staged.config.mjs",
        "package.json"
      ],
      "outputs": ["coverage/**"]
    }
  }
}
