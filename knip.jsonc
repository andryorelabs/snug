{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    // vendored agent skills (installed by `bunx skills`): their template
    // files are reference material, not part of this app's module graph.
    ".claude/skills/**",
    // `readLockHolder` and `isLockStale` are part of this module's public
    // lock API (mirrored from its original e2e-queue.ts extraction) but are
    // only exercised directly by scripts/locks.test.ts today — no current
    // caller needs them, since acquireLock/releaseLock/resolveLockDirectory
    // cover every consumer so far (scripts/lint-docs.ts included).
    "scripts/locks.ts",
    // Type declarations for `lint-policy.mjs`; TypeScript pairs them with the
    // `.mjs` import in `oxlint.config.ts`, so no module imports them by name.
    "lint-policy.d.mts",
  ],
  // The video is composition code whose exports document scene timing and
  // layout helpers, not a public API; only files and dependencies are policed.
  "ignoreIssues": {
    "apps/video/src/**": ["exports", "types"],
  },
  "workspaces": {
    "apps/extension": {
      // `#imports` is WXT's generated virtual module; knip resolves it through
      // the declaration file `wxt prepare` writes, or it reports every import.
      "paths": {
        "#imports": [".wxt/types/imports-module.d.ts"],
      },
    },
    "apps/video": {
      // Remotion loads its root, config and render scripts by name, not by
      // import, so none of them is reachable from the module graph.
      "entry": ["src/index.ts", "scripts/*.ts", "remotion.config.ts"],
      // `beats.ts` is the beat-grid helper kept for retiming a swapped track;
      // no scene imports it while the default track sits on a fixed grid.
      "ignore": ["src/audio/beats.ts"],
      // `@types/web` supplies DOM types the video tsconfig loads by name, not
      // by import. `@snug/extension` is a graph edge only: it makes Turborepo
      // hash the video against the locales and captions it imports by
      // relative path.
      "ignoreDependencies": ["@types/web", "@snug/extension"],
      // The `studio` script probes for a globally installed `remotion-studio`
      // and falls back to the local CLI, so knip sees an unresolved binary.
      "ignoreBinaries": ["remotion-studio"],
    },
    "apps/site": {
      // Each entry is run by a package script, CI or a config loader by path,
      // so nothing in the module graph imports it.
      "entry": [
        "src/scripts/render-security-headers.ts",
        "src/docs/route-middleware.ts",
        "playwright.browserstack.config.ts",
        "playwright.percy.config.ts",
        "browserstack-timing-reporter.ts",
      ],
      // `lighthouse` is pinned here so Renovate bumps it; the budget script
      // runs it through `bunx`, never an import.
      "ignoreDependencies": ["lighthouse"],
    },
    "packages/ui": {
      // The package is a registry: consumers import these files by subpath,
      // which knip cannot enumerate on its own.
      "entry": ["src/components/*.tsx", "src/hooks/*.ts", "src/lib/*.ts"],
    },
  },
}
